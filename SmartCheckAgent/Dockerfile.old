# ---- Base: official Kali rolling. Pin by digest in production for
# ---- fully reproducible builds (docker inspect gives you the digest).
FROM kalilinux/kali-rolling:latest

LABEL org.opencontainers.image.title="smartcheckagent" \
      org.opencontainers.image.description="AI-assisted pentest agent (authorized targets only)"

# Non-interactive apt; no .pyc files; unbuffered logs.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ---- Install ONLY the required tools, no recommended extras, then
# ---- delete the apt cache in the SAME layer to keep the image lean.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv \
        ca-certificates \
        libcap2-bin \
        nmap \
        curl \
        feroxbuster \
        httpx-toolkit \
        nuclei \
        exploitdb \
    && rm -rf /var/lib/apt/lists/*

# ---- Let the nmap BINARY use raw sockets without running as root, so
# ---- SYN scans work under the unprivileged user (needs --cap-add=NET_RAW
# ---- at runtime; without it, nmap auto-falls back to a connect scan).
RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip $(command -v nmap) || true

# ---- Python deps in an isolated venv (avoids Kali's PEP 668 lockout and
# ---- keeps system Python untouched).
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Install deps first (cached layer); copy code after.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent.py .
COPY smartcheck/ ./smartcheck/

# ---- Create an unprivileged user and give it the data dir (the only
# ---- path that must be writable). Everything else stays read-only.
RUN useradd --system --create-home --shell /usr/sbin/nologin scagent \
    && mkdir -p /app/data \
    && chown -R scagent:scagent /app/data

USER scagent

# Default scope + data paths live under /app; you mount real ones at runtime.
ENV SMARTCHECK_DATA_DIR=/app/data

# agent.py is the entry point; CMD args become its subcommands.
ENTRYPOINT ["python", "agent.py"]
CMD ["--help"]
